{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "type": "module",
  "scripts": {
    "test:mcp": "tsx --test src/services/mcpServer.test.ts src/services/mcpSfxProduction.test.ts",
    "test:auth": "tsx --test tests/feishuAuth.test.ts",
    "test:points": "tsx --test tests/companyPoints.test.ts src/services/companyPointPricing.test.ts src/services/sfxBatchBilling.test.ts src/services/aiGateway.test.ts src/services/measuredAudioDuration.test.ts src/services/searchBillingBatches.test.ts src/services/sfxBatch.test.ts",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server/server.cjs",
    "start": "node dist/server/server.cjs",
    "auth:hash-password": "node scripts/hash-password.mjs",
    "test:security": "node --import tsx --test src/services/serverSecurity.test.ts",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tonejs/midi": "^2.0.28",
    "@types/jszip": "^3.4.0",
    "@vitejs/plugin-react": "^5.0.4",
    "ajv": "^8.20.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "iron-session": "^8.0.4",
    "jszip": "^3.10.1",
    "lamejs": "1.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tone": "^15.1.22",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
