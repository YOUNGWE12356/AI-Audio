# All business APIs and uploaded files require an authenticated server session.
# Optional canonical origin (no trailing slash); defaults to the Feishu callback origin.
# Production requires HTTPS. With no Feishu config, development defaults to localhost:4030.
APP_ORIGIN=
# Optional local accounts, only used when Feishu is disabled. Generate each passwordHash using:
# npm run auth:hash-password
# JSON example (replace the hash; never store a plaintext password here):
# [{"id":"alice","displayName":"Alice","passwordHash":"scrypt$<32 hex salt>$<128 hex hash>"}]
# With neither Feishu nor local accounts, all business access is denied. No client-ID authentication.
AUTH_USERS_JSON=[]

# Copy this file to .env for local development.
# Never commit real API keys.
ELEVENLABS_API_KEY=
# Optional fallback key used automatically when the primary ElevenLabs key
# runs out of credits. Free-tier keys can be used, but they still follow
# ElevenLabs credit/model/rate limits.
ELEVENLABS_FALLBACK_API_KEY=
# Optional list for multiple ElevenLabs keys, separated by comma, semicolon,
# space, or new lines. Keys are tried in order after ELEVENLABS_API_KEY.
ELEVENLABS_API_KEYS=
# Legacy ElevenLabs cost-report defaults only. Creation points limits are
# managed in Settings > 创作积分管理 and persisted in data/creation-points.json.
# These values do not control the new creation-points balance.
ELEVENLABS_QUOTA_ENABLED=false
ELEVENLABS_MONTHLY_CREDITS=20000
# Account-wide credits available from the 11th of each month to the next 11th.
ELEVENLABS_ACCOUNT_CYCLE_CREDITS=600000
# Opt in to the paid Dubbing v2 path for extended target languages.
VITE_ENABLE_DUBBING_V2=false

# GPT gateway handles text and images, including server-extracted video frames.
# Audio understanding requires a separately configured audio-capable model.
GPT_MODEL=gpt-6.1-sol
GPT_REASONING_EFFORT=low

# Optional native GPT audio understanding (Chat Completions input_audio).
# Without this, audio analysis uses the existing GPT text gateway to interpret
# local signal measurements and clearly labels that it has NOT listened.
# Use an audio-capable API account; the text gateway may not offer audio models.
# Direct api.openai.com credentials can reuse OPENAI_API_KEY if no audio base URL is set.
GPT_AUDIO_API_KEY=
GPT_AUDIO_BASE_URL=
GPT_AUDIO_MODEL=gpt-audio-1.5

# Keep all keys server-side and never expose them as VITE_ values.
# The first configured gateway is used: OpenAI, Ark, then Token Hub.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6.1-sol

# Optional gateway fallbacks when direct OpenAI access is unavailable.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=
TOKENHUB_API_KEY=
TOKENHUB_BASE_URL=https://tokenhub.piegateway.me/v1
TOKENHUB_MODEL=ark/gpt-6.1-sol

# Optional. Hosting platforms usually provide PORT automatically.
PORT=4030

# Optional upload cleanup. Temporary generated files under uploads/ are removed
# after this many days; company sound-library assets under data/sfx-library are
# not affected.
UPLOADS_CLEANUP_ENABLED=true
UPLOADS_RETENTION_DAYS=7
UPLOADS_CLEANUP_INTERVAL_MS=86400000

# Optional local high-quality music separation overrides. Defaults use the
# isolated BS-RoFormer runtime under tools/music-separation/.
MUSIC_SEPARATION_PYTHON=
MUSIC_SEPARATION_SCRIPT=
MUSIC_SEPARATION_MODELS_DIR=
MUSIC_SEPARATION_TIMEOUT_MS=7200000

# Optional audio-to-MIDI engines. Use command templates when models live in
# isolated local environments. Supported placeholders: {input}, {output},
# {outputDir}. Basic Pitch example:
# BASIC_PITCH_COMMAND=.venvs\basic-pitch\Scripts\python.exe -m basic_pitch.predict --model-serialization onnx --save-midi {outputDir} {input}
BASIC_PITCH_COMMAND=
GUITAR_TRANSCRIPTION_COMMAND=
BASS_TRANSCRIPTION_COMMAND=
STRINGS_TRANSCRIPTION_COMMAND=
PIANO_TRANSCRIPTION_PYTHON=
PIANO_TRANSCRIPTION_COMMAND=
DRUM_TRANSCRIPTION_PYTHON=
DRUM_TRANSCRIPTION_COMMAND=
MUSCRIPTOR_COMMAND=
MT3_PYTHON=
MT3_COMMAND=

# Optional local Chatterbox overrides. The defaults point to the isolated
# runtime and clone script under tools/ in this repository.
LOCAL_VOICE_CLONE_PYTHON=
LOCAL_VOICE_CLONE_SCRIPT=

# Optional local CosyVoice 3 overrides. Its official runtime uses Python 3.10.
COSYVOICE_PYTHON=
COSYVOICE_SCRIPT=
COSYVOICE_REPO_DIR=
COSYVOICE_MODEL_DIR=

# Optional local Qwen3-TTS overrides. Dependencies and model weights stay in
# tools/qwen3-tts so they do not alter the Chatterbox runtime.
QWEN3_TTS_PYTHON=
QWEN3_TTS_SCRIPT=
QWEN3_TTS_MODEL_DIR=

# Optional private company sound-library root. Keep it on a dedicated data
# volume outside the application directory in production.
# Windows example: D:\\CompanyAudioLibrary
SFX_LIBRARY_DIR=

# Optional password for shared sound-library management. Keep this server-side value
# private and at least 24 characters; management elevation is bound to the
# authenticated session and expires after 30 minutes.
SFX_LIBRARY_ADMIN_PASSWORD=

# Optional company-point pricing for text models. Values are the actual API
# price in USD per million tokens. At 1 company point = USD 0.001, configured
# calls are converted automatically. Blank values use the trial defaults:
# USD 2/M input, USD 10/M output, minimum 1 point per successful request.
GPT_INPUT_USD_PER_MILLION_TOKENS=
GPT_OUTPUT_USD_PER_MILLION_TOKENS=
GPT_REASONING_USD_PER_MILLION_TOKENS=
GPT_MINIMUM_COMPANY_POINTS_PER_REQUEST=

# Native audio analysis uses a separate conservative trial baseline when these
# are blank: USD 10/M input, USD 20/M output, minimum 10 points per request.
GPT_AUDIO_INPUT_USD_PER_MILLION_TOKENS=
GPT_AUDIO_OUTPUT_USD_PER_MILLION_TOKENS=
GPT_AUDIO_MINIMUM_COMPANY_POINTS_PER_REQUEST=

# Feishu is the primary login method; all three values are required when enabled.
# Callback must be https://your-domain/api/auth/callback (HTTP localhost in development only).
# Omit the switch to enable automatically when credentials are present; false disables Feishu.
FEISHU_AUTH_ENABLED=
# Optional direct-loopback guest entry alongside Feishu login. Remote/proxied requests are denied.
LOCAL_GUEST_LOGIN_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
# Local callback: http://localhost:4030/api/auth/callback
# Add the exact callback URL in the Feishu app's security settings.
# Sessions use opaque random tokens in server memory; logout/restart revokes them.
