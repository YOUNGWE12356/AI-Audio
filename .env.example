# Copy this file to .env for local development.
# Never commit real API keys.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Optional hybrid text routing. Pure-text AI requests use GPT first, while
# image/audio/video requests continue to use Gemini.
AI_TEXT_PROVIDER=auto
GPT_MODEL=gpt-5.6-sol
GPT_REASONING_EFFORT=low

# Use either an Ark key or a Token Hub key. Never expose these as VITE_ values.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=
TOKENHUB_API_KEY=
TOKENHUB_BASE_URL=https://tokenhub.piegateway.me/v1
TOKENHUB_MODEL=ark/gpt-5.6-sol

# Optional. Hosting platforms usually provide PORT automatically.
PORT=3000

# Optional private company sound-library root. Keep it on a dedicated data
# volume outside the application directory in production.
# Windows example: D:\\CompanyAudioLibrary
SFX_LIBRARY_DIR=

# Required for shared sound-library management. Keep this server-side value
# private; successful logins receive a temporary 12-hour management session.
SFX_LIBRARY_ADMIN_PASSWORD=
