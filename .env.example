# Copy this file to .env for local development.
# Never commit real API keys.
GEMINI_API_KEY=
# Optional second-project key used automatically when the primary key is
# exhausted, rate-limited, or no longer authorized.
GEMINI_FALLBACK_API_KEY=
ELEVENLABS_API_KEY=
# Optional fallback key used automatically when the primary ElevenLabs key
# runs out of credits. Free-tier keys can be used, but they still follow
# ElevenLabs credit/model/rate limits.
ELEVENLABS_FALLBACK_API_KEY=
# Optional list for multiple ElevenLabs keys, separated by comma, semicolon,
# space, or new lines. Keys are tried in order after ELEVENLABS_API_KEY.
ELEVENLABS_API_KEYS=
# Legacy ElevenLabs cost-report defaults only. Creation points limits are
# managed in Settings > 创作积分管理 and persisted in data/creation-points.json.
# These values do not control the new creation-points balance.
ELEVENLABS_QUOTA_ENABLED=false
ELEVENLABS_MONTHLY_CREDITS=20000
# Account-wide credits available from the 11th of each month to the next 11th.
ELEVENLABS_ACCOUNT_CYCLE_CREDITS=600000
# Opt in to the paid Dubbing v2 path for extended target languages.
VITE_ENABLE_DUBBING_V2=false

# Gemini model selection is centralized in src/services/geminiRetry.ts:
# primary gemini-3.6-flash, fallback gemini-3.5-flash-lite.

# Optional hybrid text routing. Pure-text AI requests use GPT first, while
# image/audio/video requests continue to use Gemini.
AI_TEXT_PROVIDER=auto
GPT_MODEL=gpt-5.6-sol
GPT_REASONING_EFFORT=low

# Preferred: direct OpenAI Responses API. Keep all keys server-side and never
# expose them as VITE_ values. Ark and Token Hub remain optional fallbacks.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol

# Optional gateway fallbacks when direct OpenAI access is unavailable.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=
TOKENHUB_API_KEY=
TOKENHUB_BASE_URL=https://tokenhub.piegateway.me/v1
TOKENHUB_MODEL=ark/gpt-5.6-sol

# Optional. Hosting platforms usually provide PORT automatically.
PORT=4030

# Optional upload cleanup. Temporary generated files under uploads/ are removed
# after this many days; company sound-library assets under data/sfx-library are
# not affected.
UPLOADS_CLEANUP_ENABLED=true
UPLOADS_RETENTION_DAYS=7
UPLOADS_CLEANUP_INTERVAL_MS=86400000

# Optional local high-quality music separation overrides. Defaults use the
# isolated BS-RoFormer runtime under tools/music-separation/.
MUSIC_SEPARATION_PYTHON=
MUSIC_SEPARATION_SCRIPT=
MUSIC_SEPARATION_MODELS_DIR=
MUSIC_SEPARATION_TIMEOUT_MS=7200000

# Optional audio-to-MIDI engines. Use command templates when models live in
# isolated local environments. Supported placeholders: {input}, {output},
# {outputDir}. Basic Pitch example:
# BASIC_PITCH_COMMAND=.venvs\basic-pitch\Scripts\python.exe -m basic_pitch.predict --model-serialization onnx --save-midi {outputDir} {input}
BASIC_PITCH_COMMAND=
GUITAR_TRANSCRIPTION_COMMAND=
BASS_TRANSCRIPTION_COMMAND=
STRINGS_TRANSCRIPTION_COMMAND=
PIANO_TRANSCRIPTION_PYTHON=
PIANO_TRANSCRIPTION_COMMAND=
DRUM_TRANSCRIPTION_PYTHON=
DRUM_TRANSCRIPTION_COMMAND=
MUSCRIPTOR_COMMAND=
MT3_PYTHON=
MT3_COMMAND=

# Optional local Chatterbox overrides. The defaults point to the isolated
# runtime and clone script under tools/ in this repository.
LOCAL_VOICE_CLONE_PYTHON=
LOCAL_VOICE_CLONE_SCRIPT=

# Optional local CosyVoice 3 overrides. Its official runtime uses Python 3.10.
COSYVOICE_PYTHON=
COSYVOICE_SCRIPT=
COSYVOICE_REPO_DIR=
COSYVOICE_MODEL_DIR=

# Optional private company sound-library root. Keep it on a dedicated data
# volume outside the application directory in production.
# Windows example: D:\\CompanyAudioLibrary
SFX_LIBRARY_DIR=

# Required for shared sound-library management. Keep this server-side value
# private; successful logins receive a temporary 12-hour management session.
SFX_LIBRARY_ADMIN_PASSWORD=

# Feishu login: enabled automatically when credentials are supplied.
# Explicit true requires complete configuration; false keeps local guest mode.
# FEISHU_AUTH_ENABLED=true
# Optional local-only guest entry alongside Feishu login (also works in production builds).
LOCAL_GUEST_LOGIN_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
# Local callback: http://localhost:4030/api/auth/callback
# Add the exact callback URL in the Feishu app's security settings.
# Optional independent session encryption key, at least 32 characters.
# When empty, a project-specific key is derived from FEISHU_APP_SECRET.
SESSION_SECRET=
